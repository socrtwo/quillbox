<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme. The UI itself is the embedded web client; the theme only provides the
         window background and the light/dark flag the WebView uses for the
         prefers-color-scheme media query. The system bars are drawn edge-to-edge by
         MainActivity, which colours the strips behind them to match the web UI. -->
    <style name="Theme.Quillbox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/quillbox_background</item>
    </style>
</resources>
